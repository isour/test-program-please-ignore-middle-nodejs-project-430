# Скопируйте в .env: cp .env.example .env
# Строка подключения к PostgreSQL
# Значение совпадает с настройками сервиса db в docker-compose.yml
DATABASE_URL=postgres://postgres:postgres@localhost:5432/flights
# Порт HTTP-сервера (по умолчанию 8080)
# Приоритет: PORT из окружения (make start) > PORT из .env > 8080 в коде
PORT=8080
